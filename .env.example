# PostgreSQL接続情報(prodプロファイル用)。
# 実際の値は各環境の.env(Git管理対象外)またはOS/デプロイ先の環境変数で設定する。
DB_URL=jdbc:postgresql://localhost:5432/chikecan
DB_USERNAME=chikecan
DB_PASSWORD=change-me

# メール認証機能(prodプロファイル用)。
# ローカル開発ではapp.mail.enabled=false(application-local.properties)のため不要で、
# 認証URLはログへ出力される。
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=change-me
MAIL_PASSWORD=change-me
MAIL_FROM=no-reply@example.com

# フロントエンドの本番URL。認証メール内のリンク組み立てに使用する(prodプロファイル用)。
APP_BASE_URL=https://chikecan.onrender.com
